# ============================================================
# .env.example — ClarifAI-Med
# Copy this to .env and fill in your values.
# NEVER commit .env to Git.
# ============================================================

# --- LLM Provider ---
# Options: ollama | openai | anthropic
LLM_PROVIDER=ollama

# --- Ollama (local, no API key needed) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# --- OpenAI (if LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic (if LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307

# --- Embedding model (HuggingFace sentence-transformer) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- NLI Verification model ---
NLI_MODEL=roberta-large-mnli

# --- Vector Store ---
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=medquad_chunks

# --- Retrieval / chunking (CHUNK_SIZE and CHUNK_OVERLAP are tokens, not words) ---
RETRIEVAL_TOP_K=5
CHUNK_SIZE=256
CHUNK_OVERLAP=50
RANDOM_SEED=42
HF_DATASET_ID=mukulb/clustered_MEDQUAD_dataset_with_groups

# --- Verification ---
ENTAILMENT_THRESHOLD=0.7

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Data paths ---
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
TEST_QUESTIONS_PATH=./data/test_questions.json

# --- Logging ---
LOG_LEVEL=INFO
